{
  "manifest_version": 3,
  "name": "סורק מוצרים לווקומרס",
  "short_name": "Product Scraper",
  "version": "1.0.0",
  "description": "סורק מוצרים מאתרי ספקים ויצרנים, כותב אותם בעברית ומכין קובץ ייבוא לווקומרס.",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_popup": "popup.html", "default_title": "סורק מוצרים" },
  "background": { "service_worker": "background.js", "type": "module" },
  "options_page": "options.html",
  "permissions": ["activeTab", "scripting", "storage", "unlimitedStorage", "downloads", "tabs"],
  "host_permissions": ["<all_urls>"]
}
